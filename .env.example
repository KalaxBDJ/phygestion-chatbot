# meta (default, production) | baileys (local testing: scan the QR with a test phone)
PROVIDER=meta
PORT=3000

# Meta Cloud API (only used when PROVIDER=meta)
TOKEN=
NUMBER_ID=
VERIFY_TOKEN=
# Meta app dashboard > App settings > Basic > App secret. Signs every webhook POST; unset = no check.
APP_SECRET=
